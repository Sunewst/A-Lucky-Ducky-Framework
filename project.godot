; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="A Lucky Ducky"
config/version="PRE-ALHPA"
run/main_scene="uid://bm82cdsoaxkhf"
run/print_header=false
config/use_custom_user_dir=true
config/features=PackedStringArray("4.5", "C#", "Forward Plus")
boot_splash/bg_color=Color(0.876302, 0.904547, 0.877131, 1)
boot_splash/show_image=false
config/icon="uid://bwosvgpvyay54"
config/windows_native_icon="res://graphics/icon/icon.ico"

[autoload]

SaveHandler="*res://core/scripts/save/SaveHandler.gd"
SignalController="*res://core/scripts/global/signal_controller.gd"
SerialController="*res://core/scripts/serial_communication/SerialController.cs"
ArduinoCli="*res://core/scripts/serial_communication/arduino_cli.gd"

[debug]

gdscript/warnings/unused_signal=0

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/subwindows/embed_subwindows=false
window/stretch/mode="canvas_items"
window/per_pixel_transparency/allowed=true

[dotnet]

project/assembly_name="A Lucky Ducky"

[file_customization]

folder_colors={
"res://cli/": "gray",
"res://core/": "red",
"res://experimental/": "pink",
"res://garden/": "green",
"res://graphics/": "purple",
"res://projects/": "yellow",
"res://resources/": "orange",
"res://scenes/": "red",
"res://scripts/": "yellow",
"res://shaders/": "teal",
"res://showcase/": "blue"
}

